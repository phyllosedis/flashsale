# Local environment overrides for docker-compose.
# Copy to .env and adjust if your ports differ from the defaults.

# Services
SERVER_PORT=8080
USER_SERVICE_URI=http://localhost:8081
PAYMENT_SERVICE_URI=http://localhost:8082

# Database
DB_USERNAME=postgres
DB_PASSWORD=root

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_USER_CREATED=flashsale.user.outbox

# Outbox retention
OUTBOX_RETENTION_DAYS=7
